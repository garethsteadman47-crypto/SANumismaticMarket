# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Must point at a replica set (Atlas
# clusters are replica sets by default) — Prisma transactions require it.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/sa_numismatic_marketplace?retryWrites=true&w=majority"

# ── Auth.js (NextAuth) ──────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Set to "1" to force production env fail-fast checks locally (see src/lib/env.ts).
# ENFORCE_ENV_VALIDATION="0"

# Optional OAuth providers (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── File storage (mandatory video unboxing evidence, listing images) ───────
# Required in production (validated by src/lib/env.ts). Optional for local dev.
UPLOADTHING_TOKEN=""
# — or, if using S3 directly instead of UploadThing —
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="af-south-1"
AWS_S3_BUCKET_NAME=""

# ── Payment gateways (mocked in this project — see Step 5) ─────────────────
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
STITCH_CLIENT_ID=""
STITCH_CLIENT_SECRET=""
CAPITEC_PAY_MERCHANT_ID=""

# ── Scheduled jobs ───────────────────────────────────────────────────────
# Protects /api/v1/cron/settle (the 48-hour escrow hold settlement job).
# Leave unset for local dev; set in production and configure your scheduler
# (e.g. Vercel Cron) to send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
